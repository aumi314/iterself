{
  "name": "iterself",
  "version": "0.3.6",
  "description": "Local-first personal iteration desktop app for planning, recording, reviewing, and exporting life/work cycles.",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build:renderer": "node scripts/build-renderer-editor.js",
    "start": "npm run build:renderer && electron .",
    "start:packaged": "dist\\win-unpacked\\IterSelf.exe",
    "build": "npm run build:renderer && node scripts/build-win.js",
    "pack": "npm run build:renderer && electron-builder --win --x64 --dir",
    "icons": "node scripts/make-icons.js",
    "test": "node scripts/test-data.js",
    "verify": "node scripts/verify-package.js",
    "consolidate": "node scripts/consolidate-dist.js",
    "kill": "node scripts/kill-app.js",
    "smoke": "node scripts/smoke.js"
  },
  "keywords": [
    "desktop",
    "local-first",
    "planning",
    "review",
    "okr",
    "time-tracking"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "app.iterself.desktop",
    "productName": "IterSelf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/markdown": "^1.7.1",
    "codemirror-live-markdown": "^0.5.1-alpha.1"
  }
}
